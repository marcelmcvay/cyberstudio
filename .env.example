# CyberStudio environment. Copy to .env and fill what you have.
# .env is gitignored. Never commit keys. Blank means unset.
# Lookup order: real environment, then <project>/.env, then the kit's .env.

# --- Generation -------------------------------------------------------------

# Tripo image-to-3D. Key starts with tsk_. From the Tripo platform API keys page.
TRIPO_API_KEY=

# USD per Tripo credit, for the ledger. Blank logs credits with usd=0.
TRIPO_USD_PER_CREDIT=

# USD per Higgsfield credit, for the ledger. Blank logs credits with usd=0.
# Higgsfield has no key here. Auth is OAuth: run `higgsfield auth login`.
HIGGSFIELD_USD_PER_CREDIT=

# Optional fal.ai generation account (Mr. Mak).
FAL_KEY=

# --- Budget -----------------------------------------------------------------

# Soft monthly cap on generation spend. Warns, never blocks.
CYBERSTUDIO_MONTHLY_CAP_USD=300

# Warn when month to date reaches this percent of the cap.
CYBERSTUDIO_WARN_PCT=80

# --- Paths ------------------------------------------------------------------

# Project the ledger and _gen/ cache belong to. Blank uses the current directory.
# Example: ~/cyberstudio-projects/vec-factory (use the full path)
CYBERSTUDIO_PROJECT_ROOT=

# --- Links ------------------------------------------------------------------

# Optional. Dropbox token for link-asset thumbnails and file lists (M1).
DROPBOX_ACCESS_TOKEN=

# --- Blender ----------------------------------------------------------------

# Blender MCP socket. The add-on listens here while Blender is open.
BLENDER_HOST=localhost
BLENDER_PORT=9876

# --- Deferred ---------------------------------------------------------------

# Mr. Mak voice. Needs an OpenAI API key, not a ChatGPT plan. Deferred.
OPENAI_API_KEY=

# Optional extra provider account. No service uses it automatically.
OPENROUTER_API_KEY=

# Optional coordinator model override. Blank uses the Codex account default.
MRMAK_COORDINATOR_MODEL=
