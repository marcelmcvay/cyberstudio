{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberstudio:asset:v1",
  "title": "CyberStudio asset sidecar",
  "description": "One asset.json per asset folder (assets/<id>/asset.json, inbox/<id>/asset.json). Records what the asset is, where it came from, what it cost and whether it is approved. Tools fill it; people edit status, title, tags and review notes. Extends the integrity idea of scripts/asset-delivery/schema-v1.json (files carry sha256 + bytes).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "kind", "status", "created", "updated", "files", "provenance", "cost"],
  "properties": {
    "schema": { "const": "cyberstudio.asset/v1" },
    "id": { "$ref": "#/$defs/id", "description": "Matches the folder name and the ledger asset_id." },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "kind": { "enum": ["mesh", "image", "scene", "texture", "video", "reference", "document"] },
    "status": {
      "enum": ["draft", "review", "approved", "superseded"],
      "description": "draft: made, not looked at. review: waiting for Marcel or the AD team. approved: picked. superseded: kept for history, never deleted."
    },
    "superseded_by": { "$ref": "#/$defs/id" },
    "created": { "type": "string", "format": "date-time" },
    "updated": { "type": "string", "format": "date-time" },
    "tags": { "type": "array", "items": { "type": "string", "maxLength": 40 }, "uniqueItems": true },
    "ledger_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true,
      "description": "Extra ledger asset_id values whose rows roll up into this asset (e.g. part generations cell-robot and cell-table for mfg-cell). The asset's own id always counts."
    },
    "cards": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true,
      "description": "Workspace card ids (workspace.json entity ids) that show this asset."
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "description": "Forward-slash path relative to the repo root." },
          "role": { "enum": ["output", "source", "preview", "reference", "texture", "lod", "receipt"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "note": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "properties": {
        "origin": { "enum": ["generated", "imported", "link", "manual", "derived"] },
        "inputs": { "type": "array", "items": { "type": "string" }, "description": "Asset ids or repo paths this was made from (reference images, parent mesh)." },
        "link": { "type": "string", "format": "uri", "description": "Shared link for link intake (Dropbox, Drive). Never a signed or secret URL." },
        "imported_from": { "type": "string", "description": "Who or where it came from, e.g. 'AD team', 'Midjourney (manual)'." },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["job_id", "tool"],
            "properties": {
              "job_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
              "tool": { "type": "string" },
              "model": { "type": "string" },
              "ts": { "type": "string", "format": "date-time" },
              "cost_usd": { "type": "number", "minimum": 0 },
              "note": { "type": "string", "maxLength": 300 }
            }
          },
          "description": "Joined from ledger/spend.csv rows whose asset_id matches. The ledger stays the source of truth for money."
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usd", "jobs"],
      "properties": {
        "usd": { "type": "number", "minimum": 0 },
        "jobs": { "type": "integer", "minimum": 0 },
        "basis": { "enum": ["estimated", "actual", "mixed", "none"] }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "description": "For kind=mesh. Filled from the primary output GLB by gltf-transform inspect/validate; cleanup fields by the Blender pass.",
      "properties": {
        "triangles": { "type": "integer", "minimum": 0 },
        "vertices": { "type": "integer", "minimum": 0 },
        "materials": { "type": "integer", "minimum": 0 },
        "textures": { "type": "integer", "minimum": 0 },
        "bbox_m": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "description": "Width, depth, height in meters (glTF Y-up converted: x, z, y)." },
        "origin": { "enum": ["floor-center", "center", "other", "unknown"] },
        "real_scale": { "type": "boolean", "description": "True once checked against a real-world reference size." },
        "validator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "errors": { "type": "integer", "minimum": 0 },
            "warnings": { "type": "integer", "minimum": 0 },
            "checked": { "type": "string", "format": "date-time" }
          }
        },
        "engine_ready": { "type": "boolean", "description": "Only true after an engine import test (Asset Smith rule)." }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "format": { "type": "string" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "by", "text"],
            "properties": {
              "at": { "type": "string", "format": "date-time" },
              "by": { "type": "string" },
              "text": { "type": "string", "maxLength": 2000 },
              "edited_at": { "type": "string", "format": "date-time", "description": "Set when the author edits the note inside the 10 minute window." },
              "retracted_at": { "type": "string", "format": "date-time", "description": "Set when the author retracts the note. The text stays for the record." }
            }
          }
        },
        "approved_by": { "type": "string" },
        "approved_at": { "type": "string", "format": "date-time" },
        "history": {
          "type": "array",
          "description": "Status changes made by people, oldest first. Written by the Properties panel. A revert from approved moves approved_by and approved_at into its entry.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "by", "status"],
            "properties": {
              "at": { "type": "string", "format": "date-time" },
              "by": { "type": "string" },
              "status": { "enum": ["draft", "review", "approved", "superseded"] },
              "from": { "enum": ["draft", "review", "approved", "superseded"] },
              "approved_by": { "type": "string" },
              "approved_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
  }
}
